NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/seamwork
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_NAME=sw_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Stripe. Leave blank in development to use the built-in mock checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Money is stored in minor units (cents).
TAX_RATE=0.0825
SHIPPING_FLAT=1200
FREE_SHIPPING_THRESHOLD=20000

# Seed credentials
ADMIN_EMAIL=admin@seamwork.test
ADMIN_PASSWORD=admin12345
